{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "border-bottom: 2px solid color-mix(in srgb, var(--default-color), transparent 92%)",
          "color: color-mix(in srgb, var(--default-color), transparent 70%)"
        ]
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not chrome <= 109"
  ]
}